#!/usr/bin/env bash
# herdr-ports - surface active dev servers in herdr.
#
#   herdr-ports               interactive popup: checkbox list of servers, kill them
#   herdr-ports list          print the table once and exit (scripting/debug)
#   herdr-ports watch         poller: tag Spaces running >=1 TCP listener with a
#                             generic $ports badge plus one $portN token per
#                             listening port (workspace metadata, TTL-cleared)
#   herdr-ports ensure-watch  start the watcher if it is not already running
#                             (invoked by the pane.created plugin event)
#
# Ships as a herdr plugin: the popup pane and the watcher autostart are wired
# by herdr-plugin.toml. Two lines stay in the user's config.toml because
# plugins cannot inject them (see README) - either the compact badge:
#   [ui.sidebar.spaces]
#   rows = [["state_icon", "workspace", "$ports"], ["branch", "git_status"]]
# or a row per port, which herdr collapses to the live count:
#   rows = [["state_icon", "workspace"], ["branch", "git_status"],
#           ["$port1"], ["$port2"], ["$port3"], ["$port4"], ["$port5"]]
#
#   [[keys.command]]
#   key = "prefix+a"
#   type = "plugin_action"
#   command = "numbered.ports.open"
#
# Ports are attributed to a Space by matching the listener's process cwd
# against the cwds of the workspace's panes, so servers started outside herdr
# still show up as long as they run inside a workspace directory.
# Requires jq; lists sockets with netstat (macOS sysctl dump), ss (Linux
# netlink) or lsof as universal fallback - lsof also resolves cwds on macOS.
# Written for bash 3.2 (stock macOS): no mapfile, no associative arrays; and
# since read -t only takes whole seconds there, escape-sequence tails are read
# via termios VMIN=0/VTIME=1 (stty + dd) so a bare Escape quits in ~0.1s.
set -u

HERDR="${HERDR_BIN_PATH:-herdr}"
# U+21AF lightning: monochrome, single-width, no emoji variant. Nerd Font
# glyphs (e.g. the U+F1E6 plug) are not an option: herdr silently strips
# Private Use Area characters from metadata tokens.
BADGE="${HERDR_PORTS_BADGE:-↯}"
INTERVAL="${HERDR_PORTS_INTERVAL:-5}"
# Number of per-port sidebar rows ($port1..$portN) the watcher maintains. The
# ceiling has to live here as well as in config.toml: herdr resolves a fixed
# list of row templates, so a Space can never render more rows than the user
# declared. Slots past a Space's listener count are cleared, and herdr drops
# rows whose tokens all resolve to nothing - so the rendered count is dynamic
# even though the maximum is not. Keep this <= 15: a metadata report may carry
# at most 16 tokens, and the generic $ports badge takes one of them.
ROWS="${HERDR_PORTS_ROWS:-5}"
# 256-color index for the primary CTA chip, mimicking herdr's native accent
# buttons (223 ~ vesper's peach). Panes render with the terminal palette, not
# herdr's theme, so the exact accent cannot be queried - override to match.
ACCENT="${HERDR_PORTS_ACCENT:-223}"

# One line per (pid, port) TCP listener: "pid<TAB>port".
# Fastest one-shot kernel dump per platform (~5ms vs ~70ms for lsof, which
# walks every fd of every process): macOS netstat reads the whole TCP pcblist
# in a single sysctl and carries a process:pid column; Linux ss asks netlink
# inet_diag. lsof remains the universal fallback.
pid_ports() {
	if [ "$(uname 2> /dev/null)" = Darwin ] && command -v netstat > /dev/null 2>&1; then
		# The process:pid token is located from the right: macOS addresses put
		# a "." before the port, so a field ending in ":digits" can only be
		# process:pid - immune to process names containing spaces or dots
		netstat -anv -p tcp 2> /dev/null | awk '
			$6 == "LISTEN" {
				port = $4; sub(/.*\./, "", port)
				pid = ""
				for (i = NF; i > 0; i--) if ($i ~ /:[0-9]+$/) { pid = $i; sub(/.*:/, "", pid); break }
				if (port ~ /^[0-9]+$/ && pid ~ /^[0-9]+$/) print pid "\t" port
			}
		' | sort -u
	elif [ -d /proc ] && command -v ss > /dev/null 2>&1; then
		ss -ltnpH 2> /dev/null | awk '
			{
				port = $4; sub(/.*:/, "", port)
				while (match($0, /pid=[0-9]+/)) {
					print substr($0, RSTART + 4, RLENGTH - 4) "\t" port
					$0 = substr($0, RSTART + RLENGTH)
				}
			}
		' | sort -u
	elif command -v lsof > /dev/null 2>&1; then
		lsof -nP -iTCP -sTCP:LISTEN -Fpn 2> /dev/null | awk '
			/^p/ { pid = substr($0, 2) }
			/^n/ { port = $0; sub(/.*:/, "", port); if (port ~ /^[0-9]+$/) print pid "\t" port }
		' | sort -u
	fi
}

# stdin: "pid<TAB>..." lines -> "pid<TAB>cwd". Roots ("/") are dropped: system
# daemons live there and would otherwise match every workspace.
pid_cwds() {
	local pids pid cwd
	pids=$(cut -f1 | sort -un)
	[ -n "$pids" ] || return 0
	if [ -d /proc ]; then
		for pid in $pids; do
			cwd=$(readlink "/proc/$pid/cwd" 2> /dev/null) || continue
			[ "$cwd" = "/" ] && continue
			printf '%s\t%s\n' "$pid" "$cwd"
		done
	else
		lsof -a -d cwd -p "$(printf '%s\n' $pids | paste -s -d, -)" -Fpn 2> /dev/null | awk '
			/^p/ { pid = substr($0, 2) }
			/^n/ { cwd = substr($0, 2); if (cwd != "/") print pid "\t" cwd }
		'
	fi
}

# "workspace_id<TAB>cwd" for every pane (empty when the herdr server is down)
workspace_cwds() {
	"$HERDR" api snapshot 2> /dev/null | jq -r '
		.. | objects | select(has("pane_id") and has("workspace_id"))
		| .workspace_id as $w
		| ([.cwd?, .foreground_cwd?] | unique | .[])
		| select(type == "string" and . != "" and . != "/")
		| "\($w)\t\(.)"
	' 2> /dev/null | sort -u
}

# "workspace_id<TAB>label"
workspace_labels() {
	"$HERDR" workspace list 2> /dev/null | jq -r '
		.result.workspaces[]? | [.workspace_id, (.label // .workspace_id)] | @tsv
	' 2> /dev/null
}

# $1: workspace_cwds file; stdin: "pid<TAB>cwd" -> "pid<TAB>cwd<TAB>ws_id".
# A listener belongs to a Space when its cwd sits under a pane cwd or vice
# versa (server launched at the repo root while panes sit in subdirs). $HOME
# is excluded from the reverse match: launchd/user daemons living there would
# claim every workspace under it.
#
# Exactly one Space wins. Matching every candidate meant a Space with a pane
# parked at $HOME forward-matched every listener under it and claimed the whole
# machine - invisible behind a boolean badge, but it also duplicated a server
# across Spaces in the popup's SPACE column. Candidates are ranked exact (3) >
# forward, listener under pane cwd (2) > reverse (1), ties broken by the
# longest pane cwd, so the deepest enclosing Space owns the port and a $HOME
# pane only wins when nothing more specific matched.
match_join() {
	awk -F'\t' -v home="$HOME" '
		NR == FNR { wsid[NR] = $1; wcwd[NR] = $2; n = NR; next }
		{
			rank = 0; len = 0; best = ""
			for (i = 1; i <= n; i++) {
				w = wcwd[i]
				if ($2 == w) r = 3
				else if (index($2, w "/") == 1) r = 2
				else if ($2 != home && index(w, $2 "/") == 1) r = 1
				else continue
				if (r > rank || (r == rank && length(w) > len)) {
					rank = r; len = length(w); best = wsid[i]
				}
			}
			if (best != "") print $1 "\t" $2 "\t" best
		}
	' "$1" - | sort -u
}

# workspace_ids (one per line, sorted -u) running >=1 attributed TCP listener.
# Shared by the watcher (post the badge) and the kill path (diff before/after
# to clear the badge for Spaces that just lost their last server).
active_workspaces() {
	pid_ports | pid_cwds | match_join <(workspace_cwds) | cut -f3 | sort -u
}

# "workspace_id<TAB>text" - one line per (Space, listening port), sorted by
# workspace then numeric port, text like ":3000 next-server". At most $ROWS
# lines per workspace. Needs a scratch dir ($1) because the pid->workspace and
# pid->port joins are read twice and bash 3.2 has no associative arrays.
workspace_port_rows() {
	local tmp="$1" pidlist
	pid_ports > "$tmp/pp"
	[ -s "$tmp/pp" ] || return 0
	pid_cwds < "$tmp/pp" > "$tmp/cwds"
	match_join <(workspace_cwds) < "$tmp/cwds" | cut -f1,3 | sort -u > "$tmp/pidws"
	[ -s "$tmp/pidws" ] || return 0
	# one ps for every listener rather than one per pid: this runs every
	# $INTERVAL seconds, unlike build_rows which runs once per popup redraw.
	# comm is the bare executable name (bun, java, next-server) - args would
	# blow past the sidebar width and the 80-char metadata value cap anyway.
	pidlist=$(cut -f1 "$tmp/pp" | sort -un | paste -s -d, -)
	ps -o pid=,comm= -p "$pidlist" 2> /dev/null | awk '
		{ pid = $1; $1 = ""; sub(/^ +/, ""); sub(/.*\//, ""); print pid "\t" $0 }
	' > "$tmp/comm"
	# %05d port key so the lexicographic sort below orders numerically; a
	# listener bound on both v4 and v6 collapses via the (ws, port) -u keys
	awk -F'\t' '
		FILENAME == ARGV[1] { n++; wpid[n] = $1; wws[n] = $2; next }
		FILENAME == ARGV[2] { cmd[$1] = $2; next }
		{
			for (i = 1; i <= n; i++) {
				if (wpid[i] != $1) continue
				printf "%s\t%05d\t:%s%s\n", wws[i], $2, $2, \
					($1 in cmd && cmd[$1] != "" ? " " cmd[$1] : "")
			}
		}
	' "$tmp/pidws" "$tmp/comm" "$tmp/pp" \
		| LC_ALL=C sort -u -t "$(printf '\t')" -k1,1 -k2,2 \
		| awk -F'\t' -v rows="$ROWS" '
			$1 != last { last = $1; c = 0 }
			{ if (++c <= rows) print $1 "\t" $3 }
		'
}

pidfile_path() {
	echo "/tmp/herdr-ports-watcher.$(id -u).pid"
}

watcher_alive() {
	local pidfile
	pidfile=$(pidfile_path)
	[ -f "$pidfile" ] && kill -0 "$(cat "$pidfile" 2> /dev/null)" 2> /dev/null
}

# Every token this plugin owns, cleared in one report: the generic badge plus
# every per-port row slot. Used for Spaces that just lost their last listener.
clear_args() {
	local i
	printf '%s\n' --clear-token ports
	for ((i = 1; i <= ROWS; i++)); do printf '%s\n' --clear-token "port$i"; done
}

watch_loop() {
	watcher_alive && exit 0
	echo $$ > "$(pidfile_path)"
	# not local: the EXIT trap fires after this returned, under set -u
	wtmp=$(mktemp -d "${TMPDIR:-/tmp}/herdr-ports-watch.XXXXXX")
	trap 'rm -f "$(pidfile_path)"; rm -rf "$wtmp"' EXIT

	# The TTL is only a backstop (a missed poll must not flicker the badge, and a
	# dead watcher must still let the badge lapse). The fast path is an explicit
	# diff: any Space that lost its last listener since the previous poll gets a
	# --clear-token immediately, so a server killed outside the popup drops its
	# badge within one INTERVAL instead of waiting out the ~15s TTL.
	# seq is epoch-based: the server keeps the last seq per source across
	# watcher restarts and silently drops posts that do not exceed it, so a
	# counter restarting at 1 would never show again.
	local ttl=$(((INTERVAL + 10) * 1000)) ws now cur prev='' text i w a
	local -a args
	while :; do
		: > "$wtmp/rows"
		workspace_port_rows "$wtmp" > "$wtmp/rows"
		cur=$(cut -f1 "$wtmp/rows" | sort -u)
		now=$(date +%s)
		for ws in $cur; do
			# $ports stays for the compact single-glyph badge; $port1..$portN
			# carry the rows. Both go in one report so a Space never renders a
			# half-updated mix, and slots past this Space's listener count are
			# cleared in the same call - herdr then drops those rows entirely.
			args=(--source ports --ttl-ms "$ttl" --seq "$now" --token "ports=$BADGE")
			i=0
			while IFS=$'\t' read -r w text; do
				[ "$w" = "$ws" ] || continue
				i=$((i + 1))
				args+=(--token "port$i=$text")
			done < "$wtmp/rows"
			while [ "$i" -lt "$ROWS" ]; do
				i=$((i + 1))
				args+=(--clear-token "port$i")
			done
			"$HERDR" workspace report-metadata "$ws" "${args[@]}" > /dev/null 2>&1
		done
		# comm needs sorted input; cur is sorted -u above, and prev is a prior cur
		for ws in $(comm -23 <(printf '%s\n' "$prev") <(printf '%s\n' "$cur")); do
			[ -n "$ws" ] || continue
			args=(--source ports --seq "$now")
			while IFS= read -r a; do args+=("$a"); done < <(clear_args)
			"$HERDR" workspace report-metadata "$ws" "${args[@]}" > /dev/null 2>&1
		done
		prev=$cur
		sleep "$INTERVAL"
	done
}

# pane.created hook: spawn the watcher singleton and return immediately so the
# event never blocks herdr. $0 is resolved to an absolute path because the
# detached child must not depend on the hook's cwd surviving.
ensure_watch() {
	watcher_alive && exit 0
	local self
	self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
	nohup "$self" watch > /dev/null 2>&1 &
}

# "space<TAB>pid<TAB>:p1 :p2<TAB>cwd<TAB>cmd" sorted by space then first port;
# space is "-" for listeners outside any herdr workspace (sorted last)
build_rows() {
	local tmp="$1" space pid ports cwd cmd
	pid_ports > "$tmp/ports"
	pid_cwds < "$tmp/ports" > "$tmp/cwds"
	workspace_cwds > "$tmp/ws"
	workspace_labels > "$tmp/labels"
	match_join "$tmp/ws" < "$tmp/cwds" | cut -f1,3 | sort -u > "$tmp/pidws"
	awk -F'\t' '
		FILENAME == ARGV[1] { lbl[$1] = $2; next }
		FILENAME == ARGV[2] { if (!($1 in ws)) ws[$1] = ($2 in lbl ? lbl[$2] : $2); next }
		FILENAME == ARGV[3] { ports[$1] = ports[$1] (ports[$1] == "" ? "" : " ") ":" $2; if (!($1 in first)) first[$1] = $2; next }
		{ cwd[$1] = $2 }
		END {
			for (p in ports) {
				space = (p in ws ? ws[p] : "-")
				# "~" sort sentinel pushes unmatched listeners after real spaces
				printf "%s\t%05d\t%s\t%s\t%s\t%s\n", (space == "-" ? "~" : space), first[p], space, p, ports[p], (p in cwd ? cwd[p] : "-")
			}
		}
	' "$tmp/labels" "$tmp/pidws" "$tmp/ports" "$tmp/cwds" | LC_ALL=C sort -t "$(printf '\t')" -k1,1 -k2,2 | cut -f3- \
		| while IFS=$'\t' read -r space pid ports cwd; do
			cmd=$(ps -o args= -p "$pid" 2> /dev/null | head -1)
			# tabs would shift the TSV fields read back by the consumers, and
			# bash substring truncation is character-based, unlike cut -c
			# which can slice a multibyte UTF-8 char in half
			cmd=${cmd//$'\t'/ }
			cmd=${cmd:0:60}
			printf '%s\t%s\t%s\t%s\t%s\n' "$space" "$pid" "$ports" "$cwd" "${cmd:-?}"
		done
}

shorten() {
	local p="${1/#$HOME/\~}"
	[ ${#p} -gt 30 ] && p="...${p: -27}"
	printf '%s' "$p"
}

list_mode() {
	# not local: the EXIT trap fires after this returned, under set -u
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/herdr-ports.XXXXXX")
	trap 'rm -rf "$tmp"' EXIT
	local space pid ports cwd cmd
	build_rows "$tmp" > "$tmp/rows"
	printf '%-12s %-20s %-7s %-30s %s\n' 'SPACE' 'PORTS' 'PID' 'PATH' 'COMMAND'
	while IFS=$'\t' read -r space pid ports cwd cmd; do
		printf '%-12.12s %-20s %-7s %-30s %s\n' "$space" "$ports" "$pid" "$(shorten "$cwd")" "$cmd"
	done < "$tmp/rows"
}

# Helpers below run inside popup() via bash dynamic scoping: they read and
# mutate its locals (n, cur, checked, pids, needs_refresh).
cursor_up() {
	[ "$n" -gt 0 ] && cur=$((cur > 1 ? cur - 1 : n))
	return 0
}

cursor_down() {
	[ "$n" -gt 0 ] && cur=$((cur < n ? cur + 1 : 1))
	return 0
}

# TERM the checked rows (or the highlighted one when none checked). Instead of
# the old blocking 2s wait, poll fast (dev servers exit on TERM in a few ms) so
# the popup redraws immediately, escalate any straggler to KILL in a detached
# child, and clear the sidebar badge for Spaces that just lost their last
# listener rather than waiting out the metadata TTL. Outcome -> $status (footer).
kill_targets() {
	local targets='' i pid killed='' remaining='' before after ws a
	for ((i = 1; i <= n; i++)); do
		[ "${checked[i]}" = 1 ] && targets="$targets ${pids[i]}"
	done
	[ -z "$targets" ] && [ "$n" -gt 0 ] && targets="${pids[cur]}"
	[ -n "$targets" ] || return 0
	before=$(active_workspaces)
	for pid in $targets; do
		kill "$pid" 2> /dev/null && killed="$killed $pid"
	done
	# ~1s budget, but breaks the instant the last target is reaped (the common
	# case) so the redraw is not held hostage to the slowest server
	for ((i = 0; i < 20; i++)); do
		remaining=''
		for pid in $targets; do
			kill -0 "$pid" 2> /dev/null && remaining="$remaining $pid"
		done
		[ -z "$remaining" ] && break
		sleep 0.05
	done
	# stragglers get SIGKILL off the UI thread - never block the popup
	[ -n "$remaining" ] && (
		sleep 1
		for pid in $remaining; do kill -9 "$pid" 2> /dev/null; done
	) &
	# clear the $ports badge for Spaces whose last listener just died; seq must
	# exceed the watcher's last post (epoch seconds - our "now" wins unless the
	# watcher posted this exact second, in which case the TTL is the backstop)
	after=$(active_workspaces)
	local -a cargs
	for ws in $(comm -23 <(printf '%s\n' "$before") <(printf '%s\n' "$after")); do
		[ -n "$ws" ] || continue
		cargs=(--source ports --seq "$(date +%s)")
		while IFS= read -r a; do cargs+=("$a"); done < <(clear_args)
		"$HERDR" workspace report-metadata "$ws" "${cargs[@]}" > /dev/null 2>&1
	done
	status="TERM →$killed"
	[ -n "$remaining" ] && status="$status · KILL →$remaining"
	needs_refresh=1
}

# Grab whatever bytes follow an ESC into $seq: arrows and mouse events arrive
# as one burst, so a single read returns them at once, while a lone Escape
# yields nothing after VTIME (0.1s). This sidesteps bash 3.2's integer-only
# read -t, which would stall a bare Escape for a full second. When stdin is
# not a tty (tests, pipes), dd just reads the pending buffer.
read_esc_tail() {
	local saved='' tries=0
	saved=$(stty -g 2> /dev/null) || true
	[ -n "$saved" ] && stty -icanon -echo min 0 time 1 2> /dev/null
	seq=$(dd bs=64 count=1 2> /dev/null)
	# a burst can split across read(2) calls: keep reading while the tail is
	# an obviously unfinished sequence (lone CSI/SS3 introducer, or a mouse
	# event missing its M/m terminator), else the dropped half would be
	# re-read later as garbage keystrokes
	while [ "$tries" -lt 4 ]; do
		case "$seq" in
			'[' | 'O') ;;
			'[<'*)
				case "$seq" in *[Mm]*) break ;; esac
				;;
			*) break ;;
		esac
		seq="$seq$(dd bs=64 count=1 2> /dev/null)"
		tries=$((tries + 1))
	done
	[ -n "$saved" ] && stty "$saved" 2> /dev/null
	return 0
}

popup() {
	local show_all=0 n='' cur=1 needs_refresh=1 i key seq prev status=''
	local space pid ports cwd cmd mbuf body mb mx my bt3 k ev term rows=24 cols=80
	# not local: the EXIT trap fires after popup() returned, under set -u
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/herdr-ports.XXXXXX")
	trap 'rm -rf "$tmp"; printf "\033[?1006l\033[?1000l\033[?25h"' EXIT
	# full clear only once at entry - per-keypress frames home the cursor and
	# overwrite in place instead, which is what kills the flicker. SGR mouse
	# reporting (1000h+1006h): herdr forwards mouse to pane apps requesting it.
	printf '\033[?25l\033[2J\033[H\033[?1000h\033[?1006h'

	while :; do
		if [ "$needs_refresh" = 1 ]; then
			build_rows "$tmp" > "$tmp/rows"
			if [ "$show_all" = 1 ]; then
				cp "$tmp/rows" "$tmp/view"
			else
				awk -F'\t' '$1 != "-"' "$tmp/rows" > "$tmp/view"
			fi
			# carry checkmarks across refreshes by pid
			prev=' '
			for ((i = 1; i <= ${n:-0}; i++)); do
				[ "${checked[i]:-0}" = 1 ] && prev="$prev${pids[i]} "
			done
			n=0
			while IFS=$'\t' read -r space pid ports cwd cmd; do
				n=$((n + 1))
				spaces[n]=$space
				pids[n]=$pid
				portss[n]=$ports
				# shortened once here: the render loop below runs on every
				# keypress and must stay free of subshells to avoid flicker
				paths[n]=$(shorten "$cwd")
				cmds[n]=$cmd
				checked[n]=0
				case "$prev" in *" $pid "*) checked[n]=1 ;; esac
			done < "$tmp/view"
			[ "$cur" -gt "$n" ] && cur=$n
			[ "$cur" -lt 1 ] && cur=1
			needs_refresh=0
		fi

		# Flicker-free redraw: one frame assembled in memory, cursor homed
		# (\033[H, no full clear), every line erased to EOL (\033[K), leftovers
		# erased with \033[J, all emitted in a single write. No subshells in
		# this section - they are what made frames slow.
		# Screen layout: title=1, blank=2, header/none=3, rows=4..n+3,
		# footer bar pinned on the pane's last line.
		local frame='' line mark chk suffix fl size c1 c2 cw cstart
		size=$(stty size 2> /dev/null) || size=''
		rows=${size%% *}
		cols=${size##* }
		case "$rows" in '' | *[!0-9]*) rows=24 ;; esac
		case "$cols" in '' | *[!0-9]*) cols=80 ;; esac

		# COMMAND gets whatever width remains after the fixed columns (79
		# cols); without this cap long lines wrap in narrow panes and shift
		# every row below, breaking the click hitboxes
		local cmdw=$((cols - 79))
		[ "$cmdw" -lt 0 ] && cmdw=0

		frame=$'\033[H'
		suffix=''
		[ "$show_all" = 1 ] && suffix=' (all listeners)'
		frame+=$'\033[1m'"Active dev servers$suffix"$'\033[0m\033[K\n\033[K\n'
		if [ "$n" = 0 ]; then
			frame+='  (none - "a" includes listeners outside herdr workspaces)'$'\033[K\n'
		else
			printf -v line '      %-12s %-20s %-7s %-30s %s' 'SPACE' 'PORTS' 'PID' 'PATH' 'COMMAND'
			frame+=$'\033[38;5;244m'"$line"$'\033[0m\033[K\n'
			for ((i = 1; i <= n; i++)); do
				mark=' '
				[ "$i" = "$cur" ] && mark='>'
				chk=' '
				# colored, but always exactly one visible char so printf's
				# column widths stay honest
				[ "${checked[i]}" = 1 ] && chk=$'\033[38;5;114m'x$'\033[39m'
				printf -v line '%s [%s] %-12.12s %-20s %-7s %-30s %s' \
					"$mark" "$chk" "${spaces[i]}" "${portss[i]}" "${pids[i]}" "${paths[i]}" "${cmds[i]:0:cmdw}"
				if [ "$i" = "$cur" ]; then
					frame+=$'\033[48;5;237m'"$line"$'\033[K\033[0m\n'
				else
					frame+="$line"$'\033[K\n'
				fi
			done
		fi

		# Footer, native-settings style: a dim hint line, then CTA chips like
		# herdr's own (accent primary, gray secondary). Every segment records
		# its line + column span, so hints and chips are all clickable.
		bt3='a all'
		[ "$show_all" = 1 ] && bt3='a spaces'
		btn_line[2]=$((rows - 1))
		btn_line[3]=$((rows - 1))
		if [ -n "$status" ]; then
			fl="  $status"
			status=''
			btn_start[2]=0 btn_end[2]=0 btn_start[3]=0 btn_end[3]=0
		else
			fl='  ↑↓ move · space check · '
			btn_start[3]=$((${#fl} + 1))
			fl+="$bt3"
			btn_end[3]=${#fl}
			fl+=' · '
			btn_start[2]=$((${#fl} + 1))
			fl+='r refresh'
			btn_end[2]=${#fl}
		fi
		c1=' ↵ kill '
		c2=' esc close '
		cw=$((${#c1} + 2 + ${#c2}))
		cstart=$(((cols - cw) / 2))
		[ "$cstart" -lt 1 ] && cstart=1
		btn_line[1]=$rows
		btn_start[1]=$cstart
		btn_end[1]=$((cstart + ${#c1} - 1))
		btn_line[4]=$rows
		btn_start[4]=$((btn_end[1] + 3))
		btn_end[4]=$((btn_start[4] + ${#c2} - 1))
		frame+=$'\033[J\033['"$((rows - 1))"$';1H\033[38;5;244m'"$fl"$'\033[K\033[0m'
		frame+=$'\033['"$rows"$';'"$cstart"$'H\033[48;5;'"$ACCENT"$'m\033[38;5;16m'"$c1"$'\033[0m  \033[48;5;238m\033[38;5;253m'"$c2"$'\033[0m\033[K'
		printf '%s' "$frame"

		IFS= read -rsn1 key || exit 0
		case "$key" in
			$'\e')
				# bare Escape (empty tail) quits; otherwise process EVERY
				# event in the burst - fast wheel scrolls and clicks queued
				# during kill_targets' sleep arrive several per read, and
				# handling only the first would drop the rest
				read_esc_tail
				[ -z "$seq" ] && exit 0
				mbuf=$seq
				while [ -n "$mbuf" ]; do
					case "$mbuf" in
						$'\e'*) mbuf=${mbuf#$'\e'} ;;
						'[A'* | 'OA'*)
							cursor_up
							mbuf=${mbuf:2}
							;;
						'[B'* | 'OB'*)
							cursor_down
							mbuf=${mbuf:2}
							;;
						'[<'*)
							# SGR event: [<b;x;yM press, m release
							body=${mbuf#??}
							ev=${body%%[Mm]*}
							[ "$ev" = "$body" ] && break # no terminator: incomplete tail
							term=${body:${#ev}:1}
							mbuf=${body:$((${#ev} + 1))}
							[ "$term" = M ] || continue # act on press, ignore release
							IFS=';' read -r mb mx my <<< "$ev"
							case "$mb" in
								0) # left click: row = toggle checkbox, footer segment = action
									if [ "$my" -ge 4 ] && [ "$my" -le "$((n + 3))" ]; then
										cur=$((my - 3))
										checked[cur]=$((1 - checked[cur]))
									else
										for k in 1 2 3 4; do
											if [ "$my" = "${btn_line[k]:-0}" ] && [ "$mx" -ge "${btn_start[k]:-0}" ] && [ "$mx" -le "${btn_end[k]:-0}" ]; then
												case "$k" in
													1) kill_targets ;;
													2) needs_refresh=1 ;;
													3)
														show_all=$((1 - show_all))
														needs_refresh=1
														;;
													4) exit 0 ;;
												esac
												break
											fi
										done
									fi
									;;
								64) cursor_up ;;
								65) cursor_down ;;
							esac
							;;
						*) break ;;
					esac
				done
				;;
			k) cursor_up ;;
			j) cursor_down ;;
			' ') [ "$n" -gt 0 ] && checked[cur]=$((1 - checked[cur])) ;;
			'') kill_targets ;; # enter
			a)
				show_all=$((1 - show_all))
				needs_refresh=1
				;;
			r) needs_refresh=1 ;;
			q) exit 0 ;;
		esac
	done
}

case "${1:-}" in
	watch) watch_loop ;;
	ensure-watch) ensure_watch ;;
	list) list_mode ;;
	'') popup ;;
	*)
		echo "usage: herdr-ports [list|watch|ensure-watch]" >&2
		exit 2
		;;
esac
