#!/usr/bin/env bash
# herdr-ports - surface TCP listeners running inside herdr workspaces.
#
#   herdr-ports               interactive popup: checkbox list of servers, kill them
#   herdr-ports list          print the table once and exit (scripting/debug)
#   herdr-ports watch         poller: tag Spaces running >=1 TCP listener with a
#                             generic $ports badge (workspace metadata, TTL-cleared)
#   herdr-ports ensure-watch  start the watcher if it is not already running
#                             (invoked by the pane.created plugin event)
#
# Ships as a herdr plugin: the popup pane and the watcher autostart are wired
# by herdr-plugin.toml. Two lines stay in the user's config.toml because
# plugins cannot inject them (see README):
#   [ui.sidebar.spaces]
#   rows = [["state_icon", "workspace", "$ports"], ["branch", "git_status"]]
#
#   [[keys.command]]
#   key = "prefix+a"
#   type = "plugin_action"
#   command = "numbered.ports.open"
#
# Ports are attributed to a Space by matching the listener's process cwd
# against the cwds of the workspace's panes, so servers started outside herdr
# still show up as long as they run inside a workspace directory.
# Requires jq; lists sockets with netstat (macOS sysctl dump), ss (Linux
# netlink) or lsof as universal fallback - lsof also resolves cwds on macOS.
# Written for bash 3.2 (stock macOS): no mapfile, no associative arrays; and
# since read -t only takes whole seconds there, escape-sequence tails are read
# via termios VMIN=0/VTIME=1 (stty + dd) so a bare Escape quits in ~0.1s.
set -u

HERDR="${HERDR_BIN_PATH:-herdr}"
# U+21AF lightning: monochrome, single-width, no emoji variant. Nerd Font
# glyphs (e.g. the U+F1E6 plug) are not an option: herdr silently strips
# Private Use Area characters from metadata tokens.
BADGE="${HERDR_PORTS_BADGE:-↯}"
INTERVAL="${HERDR_PORTS_INTERVAL:-5}"
# 256-color index for the primary CTA chip, mimicking herdr's native accent
# buttons (223 ~ vesper's peach). Panes render with the terminal palette, not
# herdr's theme, so the exact accent cannot be queried - override to match.
ACCENT="${HERDR_PORTS_ACCENT:-223}"
GREEN=$'\033[38;2;119;192;152m' # 77C098
# Popup auto-refresh period in whole seconds (bash 3.2 read -t), 0 disables
REFRESH="${HERDR_PORTS_REFRESH:-3}"
case "$REFRESH" in '' | *[!0-9]*) REFRESH=3 ;; esac
# Wheel events that make one cursor step. Terminals send 3-4 events per notch:
# 4 gives one line per notch, 1 follows the terminal natively
WHEEL="${HERDR_PORTS_WHEEL:-4}"
case "$WHEEL" in '' | 0 | *[!0-9]*) WHEEL=4 ;; esac

# One line per (pid, port) TCP listener: "pid<TAB>port".
# Fastest one-shot kernel dump per platform (~5ms vs ~70ms for lsof, which
# walks every fd of every process): macOS netstat reads the whole TCP pcblist
# in a single sysctl and carries a process:pid column; Linux ss asks netlink
# inet_diag. lsof remains the universal fallback.
pid_ports() {
	if [ "$(uname 2> /dev/null)" = Darwin ] && command -v netstat > /dev/null 2>&1; then
		# The process:pid token is located from the right: macOS addresses put
		# a "." before the port, so a field ending in ":digits" can only be
		# process:pid - immune to process names containing spaces or dots
		netstat -anv -p tcp 2> /dev/null | awk '
			$6 == "LISTEN" {
				port = $4; sub(/.*\./, "", port)
				pid = ""
				for (i = NF; i > 0; i--) if ($i ~ /:[0-9]+$/) { pid = $i; sub(/.*:/, "", pid); break }
				if (port ~ /^[0-9]+$/ && pid ~ /^[0-9]+$/) print pid "\t" port
			}
		' | sort -u
	elif [ -d /proc ] && command -v ss > /dev/null 2>&1; then
		ss -ltnpH 2> /dev/null | awk '
			{
				port = $4; sub(/.*:/, "", port)
				while (match($0, /pid=[0-9]+/)) {
					print substr($0, RSTART + 4, RLENGTH - 4) "\t" port
					$0 = substr($0, RSTART + RLENGTH)
				}
			}
		' | sort -u
	elif command -v lsof > /dev/null 2>&1; then
		lsof -nP -iTCP -sTCP:LISTEN -Fpn 2> /dev/null | awk '
			/^p/ { pid = substr($0, 2) }
			/^n/ { port = $0; sub(/.*:/, "", port); if (port ~ /^[0-9]+$/) print pid "\t" port }
		' | sort -u
	fi
}

# stdin: "pid<TAB>..." lines -> "pid<TAB>cwd". Roots ("/") are dropped: system
# daemons live there and would otherwise match every workspace.
pid_cwds() {
	local pids pid cwd
	pids=$(cut -f1 | sort -un)
	[ -n "$pids" ] || return 0
	if [ -d /proc ]; then
		for pid in $pids; do
			cwd=$(readlink "/proc/$pid/cwd" 2> /dev/null) || continue
			[ "$cwd" = "/" ] && continue
			printf '%s\t%s\n' "$pid" "$cwd"
		done
	else
		lsof -a -d cwd -p "$(printf '%s\n' $pids | paste -s -d, -)" -Fpn 2> /dev/null | awk '
			/^p/ { pid = substr($0, 2) }
			/^n/ { cwd = substr($0, 2); if (cwd != "/") print pid "\t" cwd }
		'
	fi
}

# "workspace_id<TAB>cwd" for every pane (empty when the herdr server is down).
# Panes idling in $HOME are dropped like "/": every user daemon lives under it
# (~/Library/Containers/...) and would be claimed by that pane's Space.
workspace_cwds() {
	"$HERDR" api snapshot 2> /dev/null | jq -r --arg home "$HOME" '
		.. | objects | select(has("pane_id") and has("workspace_id"))
		| .workspace_id as $w
		| ([.cwd?, .foreground_cwd?] | unique | .[])
		| select(type == "string" and . != "" and . != "/" and . != $home)
		| "\($w)\t\(.)"
	' 2> /dev/null | sort -u
}

# "workspace_id<TAB>label"
workspace_labels() {
	"$HERDR" workspace list 2> /dev/null | jq -r '
		.result.workspaces[]? | [.workspace_id, (.label // .workspace_id)] | @tsv
	' 2> /dev/null
}

# $1: workspace_cwds file; stdin: "pid<TAB>cwd" -> "pid<TAB>cwd<TAB>ws_id".
# A listener belongs to a Space when its cwd sits under a pane cwd or vice
# versa (server launched at the repo root while panes sit in subdirs). $HOME
# is excluded from the reverse match: launchd/user daemons living there would
# claim every workspace under it.
match_join() {
	awk -F'\t' -v home="$HOME" '
		NR == FNR { wsid[NR] = $1; wcwd[NR] = $2; n = NR; next }
		{
			for (i = 1; i <= n; i++) {
				w = wcwd[i]
				if ($2 == w || index($2, w "/") == 1 || ($2 != home && index(w, $2 "/") == 1)) {
					print $1 "\t" $2 "\t" wsid[i]
				}
			}
		}
	' "$1" - | sort -u
}

# workspace_ids (one per line, sorted -u) running >=1 attributed TCP listener.
# Shared by the watcher (post the badge) and the kill path (diff before/after
# to clear the badge for Spaces that just lost their last server).
active_workspaces() {
	pid_ports | pid_cwds | match_join <(workspace_cwds) | cut -f3 | sort -u
}

pidfile_path() {
	echo "/tmp/herdr-ports-watcher.$(id -u).pid"
}

watcher_alive() {
	local pidfile
	pidfile=$(pidfile_path)
	[ -f "$pidfile" ] && kill -0 "$(cat "$pidfile" 2> /dev/null)" 2> /dev/null
}

watch_loop() {
	watcher_alive && [ "$(cat "$(pidfile_path)")" != "$$" ] && exit 0
	echo $$ > "$(pidfile_path)"
	trap '[ "$(cat "$(pidfile_path)" 2>/dev/null)" != "$$" ] || rm -f "$(pidfile_path)"' EXIT

	# The TTL is only a backstop (a missed poll must not flicker the badge, and a
	# dead watcher must still let the badge lapse). The fast path is an explicit
	# diff: any Space that lost its last listener since the previous poll gets a
	# --clear-token immediately, so a server killed outside the popup drops its
	# badge within one INTERVAL instead of waiting out the ~15s TTL.
	# seq is epoch-based: the server keeps the last seq per source across
	# watcher restarts and silently drops posts that do not exceed it, so a
	# counter restarting at 1 would never show again.
	local ttl=$(((INTERVAL + 10) * 1000)) ws now cur prev="${HERDR_PORTS_PREV:-}"
	local revision
	revision=$(cksum < "$0")
	while :; do
		[ "$(cat "$(pidfile_path)" 2>/dev/null)" = "$$" ] || exit 0
		cur=$(active_workspaces)
		now=$(date +%s)
		for ws in $cur; do
			"$HERDR" workspace report-metadata "$ws" --source ports \
				--token ports="$BADGE" --ttl-ms "$ttl" --seq "$now" > /dev/null 2>&1
		done
		# comm needs sorted input; active_workspaces already sorts -u, and prev
		# is a prior cur, so both sides are sorted
		for ws in $(comm -23 <(printf '%s\n' "$prev") <(printf '%s\n' "$cur")); do
			[ -n "$ws" ] && "$HERDR" workspace report-metadata "$ws" \
				--source ports --clear-token ports --seq "$now" > /dev/null 2>&1
		done
		prev=$cur
		sleep "$INTERVAL"
		# Reload updated detection code without losing the badge-clear diff.
		if [ "$(cksum < "$0")" != "$revision" ]; then
			export HERDR_PORTS_PREV="$prev"
			exec bash "$0" watch
		fi
	done
}

# pane.created hook: spawn the watcher singleton and return immediately so the
# event never blocks herdr. $0 is resolved to an absolute path because the
# detached child must not depend on the hook's cwd surviving.
ensure_watch() {
	watcher_alive && exit 0
	local self
	self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
	nohup "$self" watch > /dev/null 2>&1 &
}

# $1: pids, rest: ps format args. One ps per pid, all in parallel: macOS ps
# answers a single -p in ~4ms but walks the whole process table as soon as
# several are given (~110ms), so N concurrent lookups beat one batched call
# 10x. The subshell scopes wait to these children.
ps_each() {
	local p list=$1
	shift
	(
		for p in $list; do ps "$@" -p "$p" 2> /dev/null & done
		wait
	)
}

# rss arrives in KB; btop-style short units
AWK_MEM='function mem(k) { return k >= 1048576 ? sprintf("%.1fG", k / 1048576) : k >= 1024 ? int(k / 1024) "M" : k "K" }'

# "space<TAB>pid<TAB>:p1 :p2<TAB>cwd<TAB>mem<TAB>cpu<TAB>rss<TAB>cmd" sorted by space then first port;
# space is "-" for listeners outside any herdr workspace (sorted last)
build_rows() {
	local tmp="$1" pids j1 j2
	# the two herdr queries run alongside the socket dump; waited on by pid,
	# a bare wait would also sit on kill_targets' detached SIGKILL child
	workspace_cwds > "$tmp/ws" &
	j1=$!
	workspace_labels > "$tmp/labels" &
	j2=$!
	pid_ports > "$tmp/ports"
	# Resolve fresh cwds just like the watcher: processes can chdir without
	# changing their PID or listening sockets, and failed lookups can recover.
	pid_cwds < "$tmp/ports" > "$tmp/cwds"
	wait "$j1" "$j2"
	match_join "$tmp/ws" < "$tmp/cwds" | cut -f1,3 | sort -u > "$tmp/pidws"
	awk -F'\t' '
		FILENAME == ARGV[1] { lbl[$1] = $2; next }
		FILENAME == ARGV[2] { if (!($1 in ws)) ws[$1] = ($2 in lbl ? lbl[$2] : $2); next }
		FILENAME == ARGV[3] { ports[$1] = ports[$1] (ports[$1] == "" ? "" : " ") ":" $2; if (!($1 in first)) first[$1] = $2; next }
		{ cwd[$1] = $2 }
		END {
			for (p in ports) {
				space = (p in ws ? ws[p] : "-")
				# "~" sort sentinel pushes unmatched listeners after real spaces
				printf "%s\t%05d\t%s\t%s\t%s\t%s\n", (space == "-" ? "~" : space), first[p], space, p, ports[p], (p in cwd ? cwd[p] : "-")
			}
		}
	' "$tmp/labels" "$tmp/pidws" "$tmp/ports" "$tmp/cwds" | LC_ALL=C sort -t "$(printf '\t')" -k1,1 -k2,2 | cut -f3- > "$tmp/base"
	pids=$(cut -f2 "$tmp/base")
	[ -n "$pids" ] || return 0
	ps_each "$pids" -o pid= -o rss= -o %cpu= -o args= > "$tmp/ps"
	# tabs in args would shift the TSV fields read back by the consumers
	awk -F'\t' -v OFS='\t' "$AWK_MEM"'
		FILENAME == ARGV[1] {
			line = $0; sub(/^ +/, "", line); split(line, f, / +/)
			m[f[1]] = mem(f[2]); c[f[1]] = f[3]; k[f[1]] = f[2]
			sub(/^[0-9]+ +[0-9]+ +[0-9.,]+ +/, "", line); gsub(/\t/, " ", line)
			a[f[1]] = line
			next
		}
		{ print $1, $2, $3, $4, ($2 in m ? m[$2] : "-"), ($2 in c ? c[$2] : "-"), ($2 in k ? k[$2] : 0), ($2 in a ? a[$2] : "?") }
	' "$tmp/ps" "$tmp/base"
}

shorten() {
	local p="${1/#$HOME/\~}"
	[ ${#p} -gt 30 ] && p="...${p: -27}"
	printf '%s' "$p"
}

list_mode() {
	# not local: the EXIT trap fires after this returned, under set -u
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/herdr-ports.XXXXXX")
	trap 'rm -rf "$tmp"' EXIT
	local space pid ports cwd mem cpu rss cmd
	build_rows "$tmp" > "$tmp/rows"
	printf '%-12s %-20s %-7s %-30s %s\n' 'SPACE' 'PORTS' 'PID' 'PATH' 'COMMAND'
	while IFS=$'\t' read -r space pid ports cwd mem cpu rss cmd; do
		printf '%-12.12s %-20s %-7s %-30s %s\n' "$space" "$ports" "$pid" "$(shorten "$cwd")" "${cmd:0:60}"
	done < "$tmp/rows"
}

# Pad or crop $1 to exactly $2 columns into $cell, without a subshell and
# counting characters (printf widths count bytes on bash 3.2). Modes: l crops
# the right edge btop-style, e crops with an ellipsis, t keeps the tail (the
# informative end of a path), r right-aligns. $4 is a gap emitted before the
# cell only when the column is shown.
printf -v PAD '%*s' 400 ''
fit() {
	local t=$1 w=$2
	cell=''
	[ "$w" -gt 0 ] || return 0
	local gap=${4:-}
	if [ ${#t} -gt "$w" ]; then
		case "$3" in
			e) t="${t:0:w-1}…" ;;
			t) t="…${t:${#t}-w+1}" ;;
			*) t=${t:0:w} ;;
		esac
	fi
	if [ "$3" = r ]; then
		cell="$gap${PAD:0:w-${#t}}$t"
	else
		cell="$gap$t${PAD:0:w-${#t}}"
	fi
}

# Helpers below run inside popup() via bash dynamic scoping: they read and
# mutate its locals (n, cur, checked, pids, needs_refresh).
cursor_up() {
	[ "$cur" -gt 1 ] && cur=$((cur - 1))
	return 0
}

cursor_down() {
	[ "$cur" -lt "$n" ] && cur=$((cur + 1))
	return 0
}

# Totals of the listed rows into $tmem/$tcpu, shown under the MEM and CPU%
# columns. Integer math only: cpu is summed in tenths ("12.4" -> 124).
sum_totals() {
	local i k=0 c=0 v
	for ((i = 1; i <= n; i++)); do
		case "${rsss[i]}" in '' | *[!0-9]*) ;; *) k=$((k + rsss[i])) ;; esac
		v=${cpus[i]/,/.}
		case "$v" in
			*[!0-9.]* | '' | *.*.*) ;;
			*.*) c=$((c + 10#${v%.*}0 + 10#${v#*.})) ;;
			*) c=$((c + 10#${v}0)) ;;
		esac
	done
	if [ "$k" -ge 1048576 ]; then
		tmem="$((k / 1048576)).$((k % 1048576 * 10 / 1048576))G"
	elif [ "$k" -ge 1024 ]; then
		tmem="$((k / 1024))M"
	else
		tmem="${k}K"
	fi
	tcpu="$((c / 10)).$((c % 10))"
}

# TERM the checked rows (or the highlighted one when none checked). Instead of
# the old blocking 2s wait, poll fast (dev servers exit on TERM in a few ms) so
# the popup redraws immediately, escalate any straggler to KILL in a detached
# child, and clear the sidebar badge for Spaces that just lost their last
# listener rather than waiting out the metadata TTL. Outcome -> $status (footer).
kill_targets() {
	local targets='' i pid killed='' remaining='' before after ws
	for ((i = 1; i <= n; i++)); do
		[ "${checked[i]}" = 1 ] && targets="$targets ${pids[i]}"
	done
	[ -z "$targets" ] && [ "$n" -gt 0 ] && targets="${pids[cur]}"
	[ -n "$targets" ] || return 0
	before=$(active_workspaces)
	for pid in $targets; do
		kill "$pid" 2> /dev/null && killed="$killed $pid"
	done
	# ~1s budget, but breaks the instant the last target is reaped (the common
	# case) so the redraw is not held hostage to the slowest server
	for ((i = 0; i < 20; i++)); do
		remaining=''
		for pid in $targets; do
			kill -0 "$pid" 2> /dev/null && remaining="$remaining $pid"
		done
		[ -z "$remaining" ] && break
		sleep 0.05
	done
	# stragglers get SIGKILL off the UI thread - never block the popup
	[ -n "$remaining" ] && (
		sleep 1
		for pid in $remaining; do kill -9 "$pid" 2> /dev/null; done
	) &
	# clear the $ports badge for Spaces whose last listener just died; seq must
	# exceed the watcher's last post (epoch seconds - our "now" wins unless the
	# watcher posted this exact second, in which case the TTL is the backstop)
	after=$(active_workspaces)
	for ws in $(comm -23 <(printf '%s\n' "$before") <(printf '%s\n' "$after")); do
		[ -n "$ws" ] && "$HERDR" workspace report-metadata "$ws" \
			--source ports --clear-token ports --seq "$(date +%s)" > /dev/null 2>&1
	done
	status="TERM →$killed"
	[ -n "$remaining" ] && status="$status · KILL →$remaining"
	needs_refresh=1
}

# Grab whatever bytes follow an ESC into $seq: arrows and mouse events arrive
# as one burst, so a single read returns them at once, while a lone Escape
# yields nothing after VTIME (0.1s). This sidesteps bash 3.2's integer-only
# read -t, which would stall a bare Escape for a full second. When stdin is
# not a tty (tests, pipes), dd just reads the pending buffer.
#
# Fast path, fork-free: ask the terminal for a status report (DSR 5n). Its
# "\e[0n" reply queues up BEHIND whatever input is already pending, so reading
# byte by byte until the reply shows up slurps the whole backlog (a wheel flick
# is dozens of events) in one go, and a bare Escape is recognised instantly as
# "nothing before the reply". A terminal that never answers costs one 1s
# timeout, after which the stty/dd path below takes over for good.
read_esc_tail() {
	local saved='' tries=0 ch
	seq=''
	if [ "$dsr_ok" = 1 ]; then
		printf '\033[5n'
		while IFS= read -rsn1 -t 1 ch; do
			seq+=$ch
			case "$seq" in
				*$'\e[0n')
					seq=${seq%$'\e[0n'}
					return 0
					;;
			esac
		done
		dsr_ok=0
		return 0
	fi
	saved=$(stty -g 2> /dev/null) || true
	[ -n "$saved" ] && stty -icanon -echo min 0 time 1 2> /dev/null
	seq=$(dd bs=4096 count=1 2> /dev/null)
	# a burst can split across read(2) calls: keep reading while the tail is
	# an obviously unfinished sequence (lone CSI/SS3 introducer, or a mouse
	# event missing its M/m terminator), else the dropped half would be
	# re-read later as garbage keystrokes
	while [ "$tries" -lt 4 ]; do
		case "$seq" in
			'[' | 'O') ;;
			'[<'*)
				case "$seq" in *[Mm]*) break ;; esac
				;;
			*) break ;;
		esac
		seq="$seq$(dd bs=4096 count=1 2> /dev/null)"
		tries=$((tries + 1))
	done
	[ -n "$saved" ] && stty "$saved" 2> /dev/null
	return 0
}

popup() {
	local show_all=0 n=0 cur=1 top=0 msp=0 mpo=0 mpa=0 mpr=0 needs_refresh=1 needs_view=0 booting=1 i key seq prev status=''
	local tick=0 resized=1 y t0 rc dsr_ok=1 wacc=0
	local space pid ports cwd mem cpu rss cmd tmem='' tcpu='' mbuf body mb mx my bt3 k ev term rows=24 cols=80
	# not local: the EXIT trap fires after popup() returned, under set -u
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/herdr-ports.XXXXXX")
	# Echo stays off for the whole popup, not just inside read -s: wheel bursts
	# landing while a refresh runs would otherwise be echoed by the tty as
	# "^[[<65;70;9M" garbage over rows the diffed redraw never repaints.
	# not local either: restored by the EXIT trap
	tty_saved=$(stty -g 2> /dev/null) || tty_saved=''
	[ -n "$tty_saved" ] && stty -echo -icanon min 1 time 0 2> /dev/null
	trap 'rm -rf "$tmp"; [ -n "$tty_saved" ] && stty "$tty_saved" 2> /dev/null; printf "\033[?1006l\033[?1000l\033[?25h"' EXIT
	# the pane size is only re-queried (a stty fork) after a resize
	trap 'resized=1' WINCH
	# SGR mouse reporting (1000h+1006h): herdr forwards mouse to pane apps
	# requesting it
	printf '\033[?25l\033[?1000h\033[?1006h'

	while :; do
		# Attribution can change even when the listening sockets do not.
		# Refresh the same inputs as the badge watcher on every timer tick.
		if [ "$tick" = 1 ]; then
			tick=0
			needs_refresh=1
		fi
		# needs_refresh rebuilds the rows (slow: sockets, cwds, herdr snapshot);
		# needs_view only re-filters the rows already on disk, fork-free, so
		# toggling "a" is instant
		# the very first frame is painted before any lookup so the popup never
		# opens onto an empty pane
		if [ "$needs_refresh" = 1 ] && [ "$booting" = 0 ]; then
			build_rows "$tmp" > "$tmp/rows"
			needs_view=1
		fi
		if [ "$needs_view" = 1 ] && [ "$booting" = 0 ]; then
			# carry checkmarks across refreshes by pid
			prev=' '
			for ((i = 1; i <= ${n:-0}; i++)); do
				[ "${checked[i]:-0}" = 1 ] && prev="$prev${pids[i]} "
			done
			n=0 msp=0 mpo=0 mpa=0 mpr=0
			while IFS=$'\t' read -r space pid ports cwd mem cpu rss cmd; do
				[ "$show_all" = 0 ] && [ "$space" = - ] && continue
				n=$((n + 1))
				mems[n]=$mem
				cpus[n]=$cpu
				rsss[n]=$rss
				spaces[n]=$space
				pids[n]=$pid
				portss[n]=$ports
				# content widths measured once here: the render loop below runs
				# on every keypress and must stay free of subshells
				paths[n]=${cwd/#$HOME/\~}
				[ ${#space} -gt "$msp" ] && msp=${#space}
				[ ${#ports} -gt "$mpo" ] && mpo=${#ports}
				[ ${#paths[n]} -gt "$mpa" ] && mpa=${#paths[n]}
				cmds[n]=${cmd:0:300}
				[ ${#cmds[n]} -gt "$mpr" ] && mpr=${#cmds[n]}
				checked[n]=0
				case "$prev" in *" $pid "*) checked[n]=1 ;; esac
			done < "$tmp/rows"
			[ "$cur" -gt "$n" ] && cur=$n
			[ "$cur" -lt 1 ] && cur=1
			sum_totals
			needs_refresh=0 needs_view=0
		fi

		# Flicker-free redraw: every screen line is assembled into scr[], diffed
		# against what is already on screen (old[]) and only the lines that
		# changed are repainted, in a single write - a cursor move repaints two
		# rows, a metrics tick only the rows whose numbers moved. No subshells
		# in this section - they are what made frames slow.
		# Screen layout: title=1, blank=2, header/none=3, rows=4..n+3,
		# help + CTA chips pinned on the pane's last line.
		local frame='' line chk fl size c1 c2 cw cstart fstart thumb tpos
		if [ "$resized" = 1 ]; then
			resized=0
			size=$(stty size 2> /dev/null) || size=''
			rows=${size%% *}
			cols=${size##* }
			case "$rows" in '' | *[!0-9]*) rows=24 ;; esac
			case "$cols" in '' | *[!0-9]*) cols=80 ;; esac
			old=()
			frame=$'\033[2J'
		fi
		scr=()
		sbar=()

		# rows beyond the pane scroll with the cursor instead of running over
		# the footer
		vis=$((rows - 5))
		[ "$vis" -lt 1 ] && vis=1
		[ "$cur" -le "$top" ] && top=$((cur - 1))
		[ "$cur" -gt $((top + vis)) ] && top=$((cur - vis))
		[ "$top" -lt 0 ] && top=0
		last=$((top + vis))
		[ "$last" -gt "$n" ] && last=$n
		# the scrollbar takes the last column plus a gap when rows overflow
		lcols=$cols
		[ "$n" -gt "$vis" ] && lcols=$((cols - 2))

		# btop-style columns: SPACE and PORTS hug their content, PROGRAM and PATH
		# share what is left (PATH absorbs the slack), PID MEM CPU% sit flush
		# right so the table spans the pane. As the pane narrows columns drop
		# in order (PROGRAM, MEM+CPU%, PATH, PID), then PORTS and SPACE crop.
		# No line may ever wrap: a wrapped row shifts everything below and
		# breaks the click hitboxes.
		local spw=$msp pw=$mpo pidw=7 pathw=0 cmdw=0 memw=0 cpuw=0 metw=13 rest avail vis last lcols
		[ "$spw" -lt 5 ] && spw=5
		[ "$spw" -gt 20 ] && spw=20
		[ "$pw" -lt 5 ] && pw=5
		[ "$pw" -gt 24 ] && pw=24
		# width left for PROGRAM + PATH, their gaps included
		rest=$((lcols - 6 - spw - 1 - pw - 1 - pidw - 1))
		if [ "$rest" -lt 13 ]; then
			[ "$spw" -gt 12 ] && spw=12
			[ "$pw" -gt 12 ] && pw=12
			rest=$((lcols - 6 - spw - 1 - pw - 1 - pidw - 1))
		fi
		if [ $((rest - metw)) -ge 13 ]; then
			memw=6 cpuw=5
			rest=$((rest - metw))
		fi
		if [ "$rest" -ge 36 ]; then
			pathw=$mpa
			[ "$pathw" -gt $(((rest - 2) * 2 / 5)) ] && pathw=$(((rest - 2) * 2 / 5))
			[ "$pathw" -lt 12 ] && pathw=12
			cmdw=$((rest - 2 - pathw))
			[ "$cmdw" -gt "$mpr" ] && cmdw=$mpr
			[ "$cmdw" -lt 7 ] && cmdw=7
			pathw=$((rest - 2 - cmdw))
		elif [ "$rest" -ge 13 ]; then
			pathw=$((rest - 1))
		elif [ "$rest" -ge 0 ]; then
			pw=$((pw + rest))
			[ "$pw" -gt "$mpo" ] && pw=$mpo
			[ "$pw" -lt 5 ] && pw=5
		else
			pidw=0
			avail=$((lcols - 7))
			pw=$((avail - spw - 1))
			[ "$pw" -gt "$mpo" ] && pw=$mpo
			if [ $((spw + 1 + pw)) -gt "$avail" ]; then
				spw=$((avail - pw - 1))
				if [ "$spw" -lt 4 ]; then
					spw=4
					pw=$((avail - 5))
				fi
			fi
		fi

		line='Listening in workspaces'
		[ "$show_all" = 1 ] && line='All listeners'
		scr[1]=$'\033[1m'"${line:0:cols-1}"$'\033[22m\033[38;5;'"$ACCENT"'m'
		k=${#line}
		if [ "$booting" = 0 ] && [ $((k + ${#n} + 3)) -le "$cols" ]; then
			scr[1]+="  $n"
			k=$((k + ${#n} + 2))
		fi
		# totals of the listed rows, top right, in line with their columns
		if [ "$memw" -gt 0 ] && [ "$n" -gt 0 ] && [ $((lcols - 1 - metw - k)) -ge 2 ]; then
			scr[1]+=${PAD:0:lcols-1-metw-k}
			fit "$tmem" "$memw" r ' '
			scr[1]+=$GREEN$cell
			fit "$tcpu" "$cpuw" r ' '
			scr[1]+=$'\033[38;5;250m'"$cell"
		fi
		if [ "$n" = 0 ]; then
			line='  none - "a" lists every listener on the machine'
			[ "$booting" = 1 ] && line='  scanning…'
			scr[3]=$'\033[38;5;244m'"$line"
		else
			fit 'Space' "$spw" l
			line="      $cell"
			fit 'Program' "$cmdw" l ' '
			line+=$cell
			fit 'Ports' "$pw" l ' '
			line+=$cell
			fit 'Path' "$pathw" l ' '
			line+=$cell
			fit 'Pid' "$pidw" r ' '
			line+=$cell
			fit 'Mem' "$memw" r ' '
			line+=$cell
			fit 'Cpu%' "$cpuw" r ' '
			line+=$cell
			scr[3]=$'\033[1m'"$line"
			for ((i = top + 1; i <= last; i++)); do
				line=''
				if [ "$i" = "$cur" ]; then
					line=$'\033[48;5;237m\033[38;5;'"$ACCENT"$'m▌'
				else
					line=' '
				fi
				chk=' '
				[ "${checked[i]}" = 1 ] && chk=${GREEN}x
				line+=$'\033[38;5;240m ['"$chk"$'\033[38;5;240m] '
				fit "${spaces[i]}" "$spw" l
				if [ "${spaces[i]}" = - ]; then
					line+=$'\033[38;5;240m'"$cell"
				else
					line+=$GREEN$cell
				fi
				fit "${cmds[i]}" "$cmdw" l ' '
				line+=$'\033[38;5;250m'"$cell"
				fit "${portss[i]}" "$pw" e ' '
				line+=$'\033[38;5;'"$ACCENT"'m'"$cell"
				fit "${paths[i]}" "$pathw" t ' '
				line+=$'\033[38;5;244m'"$cell"
				fit "${pids[i]}" "$pidw" r ' '
				line+=$'\033[38;5;244m'"$cell"
				fit "${mems[i]}" "$memw" r ' '
				line+=$GREEN$cell
				fit "${cpus[i]}" "$cpuw" r ' '
				line+=$'\033[38;5;250m'"$cell"
				scr[i - top + 3]=$line
			done
			# scrollbar in the free right-margin column, only when rows overflow
			if [ "$n" -gt "$vis" ]; then
				thumb=$((vis * vis / n))
				[ "$thumb" -lt 1 ] && thumb=1
				tpos=$((top * (vis - thumb) / (n - vis)))
				for ((i = 0; i < vis; i++)); do
					if [ "$i" -ge "$tpos" ] && [ "$i" -lt $((tpos + thumb)) ]; then
						sbar[i + 4]=$'\033['"$cols"$'G\033[38;5;245m█\033[0m'
					else
						sbar[i + 4]=$'\033['"$cols"$'G\033[38;5;238m│\033[0m'
					fi
				done
			fi
		fi

		# Footer, one line: dim help on the left (replaced by the outcome of the
		# last kill), CTA chips like herdr's own on the right (accent primary,
		# gray secondary), flush with the table edge. Every segment records its
		# column span, so hints and chips are all clickable.
		bt3='a all'
		[ "$show_all" = 1 ] && bt3='a spaces'
		fstart=2
		if [ -n "$status" ]; then
			fl=$status
			status=''
			btn_start[2]=0 btn_end[2]=0 btn_start[3]=0 btn_end[3]=0
		else
			fl='↑↓ move · space check · '
			btn_start[3]=$((${#fl} + 1 + fstart))
			fl+="$bt3"
			btn_end[3]=$((${#fl} + fstart))
			fl+=' · '
			btn_start[2]=$((${#fl} + 1 + fstart))
			fl+='r refresh'
			btn_end[2]=$((${#fl} + fstart))
		fi
		c1=' ↵ kill '
		c2=' esc close '
		cw=$((${#c1} + 2 + ${#c2}))
		cstart=$((lcols - cw))
		[ "$cstart" -lt 1 ] && cstart=1
		btn_start[1]=$cstart
		btn_end[1]=$((cstart + ${#c1} - 1))
		btn_start[4]=$((btn_end[1] + 3))
		btn_end[4]=$((btn_start[4] + ${#c2} - 1))
		# the help line gets what the chips leave
		k=$((cstart - 1 - fstart - 2))
		[ "$k" -lt 0 ] && k=0
		fit "$fl" "$k" l
		cw=$((cstart - 1 - fstart - k))
		[ "$cw" -lt 0 ] && cw=0
		# the boot frame only paints left-anchored content: herdr may still be
		# resizing the pane at that point, and anything pinned to the right
		# edge would visibly jump once the real size lands
		scr[rows]="${PAD:0:fstart}"$'\033[38;5;244m'"$cell"$'\033[0m'
		[ "$booting" = 0 ] && scr[rows]+="${PAD:0:cw}"$'\033[48;5;'"$ACCENT"$'m\033[38;5;16m'"$c1"$'\033[0m  \033[48;5;238m\033[38;5;253m'"$c2"$'\033[0m'
		# \033[K before the reset so the cursor row's background runs to the edge
		# the scrollbar cell is painted after the erase, which would wipe it
		for ((y = 1; y <= rows; y++)); do
			line="${scr[y]:-}${sbar[y]:-}"
			[ "$line" = "${old[y]:-}" ] && continue
			frame+=$'\033['"$y"$';1H'"${scr[y]:-}"$'\033[K\033[0m'"${sbar[y]:-}"
			old[y]=$line
		done
		[ -n "$frame" ] && printf '%s' "$frame"
		if [ "$booting" = 1 ]; then
			booting=0
			continue
		fi

		# A read timeout drives the auto-refresh. bash 3.2 reports a timeout
		# like EOF (status 1), so EOF is told apart by returning at once.
		t0=$SECONDS
		if [ "$REFRESH" -gt 0 ]; then
			IFS= read -rsn1 -t "$REFRESH" key
		else
			IFS= read -rsn1 key
		fi
		rc=$?
		if [ "$rc" != 0 ]; then
			# a WINCH may interrupt read: repaint at the new size
			[ "$resized" = 1 ] && continue
			[ "$REFRESH" -gt 0 ] && [ $((SECONDS - t0)) -ge 1 ] || exit 0
			tick=1
			continue
		fi
		case "$key" in
			$'\e')
				# bare Escape (empty tail) quits; otherwise process EVERY
				# event in the burst - fast wheel scrolls and clicks queued
				# during kill_targets' sleep arrive several per read, and
				# handling only the first would drop the rest
				read_esc_tail
				[ -z "$seq" ] && exit 0
				mbuf=$seq
				wacc=0
				while [ -n "$mbuf" ]; do
					case "$mbuf" in
						$'\e'*) mbuf=${mbuf#$'\e'} ;;
						'[A'* | 'OA'*)
							cursor_up
							mbuf=${mbuf:2}
							;;
						'[B'* | 'OB'*)
							cursor_down
							mbuf=${mbuf:2}
							;;
						'[<'*)
							# SGR event: [<b;x;yM press, m release
							body=${mbuf#??}
							ev=${body%%[Mm]*}
							[ "$ev" = "$body" ] && break # no terminator: incomplete tail
							term=${body:${#ev}:1}
							mbuf=${body:$((${#ev} + 1))}
							[ "$term" = M ] || continue # act on press, ignore release
							IFS=';' read -r mb mx my <<< "$ev"
							case "$mb" in
								0) # left click: row = toggle checkbox, footer segment = action
									if [ "$my" -ge 4 ] && [ "$my" -le "$((last - top + 3))" ]; then
										cur=$((my - 3 + top))
										checked[cur]=$((1 - checked[cur]))
									else
										for k in 1 2 3 4; do
											if [ "$my" = "$rows" ] && [ "$mx" -ge "${btn_start[k]:-0}" ] && [ "$mx" -le "${btn_end[k]:-0}" ]; then
												case "$k" in
													1) kill_targets ;;
													2) needs_refresh=1 ;;
													3)
														show_all=$((1 - show_all))
														needs_view=1
														;;
													4) exit 0 ;;
												esac
												break
											fi
										done
									fi
									;;
								64) wacc=$((wacc - 1)) ;;
								65) wacc=$((wacc + 1)) ;;
							esac
							;;
						*) break ;;
					esac
				done
				# terminals send several wheel events per notch (3-4): a burst
				# of up to WHEEL events is one step, rounded up so a notch
				# always moves, and a whole backlog is applied before a single
				# redraw
				for ((i = (${wacc#-} + WHEEL - 1) / WHEEL; i > 0; i--)); do
					if [ "$wacc" -lt 0 ]; then cursor_up; else cursor_down; fi
				done
				;;
			k) cursor_up ;;
			j) cursor_down ;;
			' ') [ "$n" -gt 0 ] && checked[cur]=$((1 - checked[cur])) ;;
			'') kill_targets ;; # enter
			a)
				show_all=$((1 - show_all))
				needs_view=1
				;;
			r) needs_refresh=1 resized=1 ;; # also a full repaint, should the screen ever get corrupted
			q) exit 0 ;;
		esac
	done
}

case "${1:-}" in
	watch) watch_loop ;;
	ensure-watch) ensure_watch ;;
	list) list_mode ;;
	'') popup ;;
	*)
		echo "usage: herdr-ports [list|watch|ensure-watch]" >&2
		exit 2
		;;
esac
